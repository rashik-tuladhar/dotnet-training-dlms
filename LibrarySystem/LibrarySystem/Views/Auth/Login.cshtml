@model LibrarySystem.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center align-items-center min-vh-75 py-5">
    <div class="col-md-5">
        <div class="card border-0 shadow-lg login-card">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-gradient">Library System</h2>
                    <p class="text-muted">Sign in with ASP.NET Core Identity</p>
                </div>

                <form asp-action="Login" method="post" class="needs-validation">
                    <input type="hidden" asp-for="ReturnUrl" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger border-0 rounded-3 shadow-sm py-3 mb-4" role="alert">
                            <div asp-validation-summary="ModelOnly" class="small text-danger fw-semibold"></div>
                        </div>
                    }

                    <div class="form-floating mb-3">
                        <input asp-for="Username" class="form-control rounded-3" placeholder="Username" id="floatingUsername" autocomplete="username" required aria-required="true" />
                        <label asp-for="Username" for="floatingUsername">Username</label>
                        <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Password" class="form-control rounded-3" placeholder="Password" id="floatingPassword" autocomplete="current-password" required aria-required="true" />
                        <label asp-for="Password" for="floatingPassword">Password</label>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-semibold shadow-sm transition-all btn-login">
                        Sign In
                    </button>
                </form>

                <div class="mt-4 border-top pt-4 text-center">
                    <p class="text-muted small mb-1">Database seeded accounts:</p>
                    <div class="d-flex justify-content-around text-start small">
                        <div>
                            <span class="badge bg-secondary-subtle text-secondary-emphasis">Super Admin</span>
                            <div class="mt-1 font-monospace">admin / adminpassword</div>
                        </div>
                        <div>
                            <span class="badge bg-secondary-subtle text-secondary-emphasis">Staff</span>
                            <div class="mt-1 font-monospace">staff / staffpassword</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .min-vh-75 {
        min-height: 75vh;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 20px !important;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .login-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1) !important;
    }

    .text-gradient {
        background: linear-gradient(135deg, #6366f1, #3b82f6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .form-floating > .form-control {
        border: 1.5px solid #e2e8f0;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-floating > .form-control:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
    }

    .btn-login {
        background: linear-gradient(135deg, #6366f1, #3b82f6);
        border: none;
        transition: all 0.3s ease;
    }

    .btn-login:hover {
        background: linear-gradient(135deg, #4f46e5, #2563eb);
        transform: scale(1.02);
        box-shadow: 0 6px 20px rgba(99, 102, 241, 0.3) !important;
    }

    .btn-login:active {
        transform: scale(0.98);
    }

    .transition-all {
        transition: all 0.2s ease-in-out;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
