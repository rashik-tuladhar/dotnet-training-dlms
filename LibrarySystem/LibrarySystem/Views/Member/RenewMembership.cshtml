@model LibrarySystem.Shared.MemberData.MemberDetails

<form asp-controller="Member" asp-action="RenewMembership" method="post">

    <input type="hidden" asp-for="MemberId" />

    <div>
        <label>Member Name</label>
        <input asp-for="MemberName" readonly />
    </div>

    <div>
        <label>Enter Days</label>
        <input type="number" name="days" />
    </div>

    <button type="submit">Renew Membership</button>

</form>