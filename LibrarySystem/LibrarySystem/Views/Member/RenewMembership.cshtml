@model LibrarySystem.Shared.MemberData.MemberDetails

<form asp-controller="Member"
      asp-action="RenewMembership"
      method="post">

    <input type="hidden"
           name="memberId"
           value="@Model.MemberId" />

    <div>
        <label>Member Name</label>
        <input asp-for="MemberName" readonly />
    </div>

    <div>
        <label>Enter Days</label>
        <input type="number"
               name="days"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Renew Membership
    </button>

</form>