@using LibrarySystem.Shared.MemberData
@model List<MemberDetails>
<h1>Hello Member Index</h1>

<a asp-controller="Member" asp-action="AddMembers" class="btn btn-primary">Add Member</a>
<a asp-controller="Member" asp-action="RenewMembership" calss="btn btn-primary">Renew MemberShip</a>

@{
    string tempDataMessage = TempData["isSuccess"] as string;
    if (tempDataMessage == "YES")
    {
        <span class="text-success">@TempData["Message"]</span>
    }
    else
    {
        <span class="text-danger">@TempData["Message"]</span>
    }
}

