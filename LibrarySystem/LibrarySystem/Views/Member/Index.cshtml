<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>SN</th>
                <th>Member Id</th>
                <th>Member Name</th>
                <th>Member Address</th>
                <th>Member Join Date</th>
                <th>Member Expiry Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
                foreach (var member in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@member.MemberId</td>
                        <td>@member.MemberName</td>
                        <td>@member.Address</td>
                        <td>@member.JoinedDate</td>
                        <td>@member.ExpirationDate</td>

                        <td><a class="btn btn-primary btn-sm" asp-controller="Member" asp-action="EditMembers" asp-route-id="@member.MemberId">Edit</a></td>
                    </tr>
                    i++;
                }
            }
        </tbody>
    </table>
</div>