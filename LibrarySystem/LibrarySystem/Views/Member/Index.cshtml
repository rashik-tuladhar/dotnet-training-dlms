@using LibrarySystem.Shared.MemberData
@model List<MemberDetails>

<h1>Hello Member Index</h1>

<a asp-controller="Member" asp-action="AddMember" class="btn btn-primary">Add Members</a>

@{
    string tempDataMessage = TempData["isSuccess"] as string;

    if (tempDataMessage == "YES")
    {
        <span class="text-success">@TempData["Message"]</span>
    }
    else
    {
        <span class="text-danger">@TempData["Message"]</span>
    }
}

<form method="get" asp-controller="Member" asp-action="Index">
    <br> <div class="row mb-3">
    <div class="col-md-4">
        <input type="text"
               name="searchText"
               value="@Context.Request.Query["searchText"]"
               class="form-control"
               placeholder="Search member name..." />
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">
            Search
        </button>
    </div>
</div>
</form>


<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>SN</th>
                <th>Member Id</th>
                <th>Member Name</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Email</th>
                <th>Joined Date</th>
                <th>Expiration Date</th>
                <th>Membership Type</th>
                <th>Status</th>
                <th>Created By</th>
                <th>Modified By</th>
                <th>Operations</th>
            </tr>
        </thead>

        <tbody>
            @{
                int i = 1;

                foreach (var member in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@member.MemberId</td>
                        <td>@member.MemberName</td>
                        <td>@member.Phone</td>
                        <td>@member.Address</td>
                        <td>@member.Email</td>
                        <td>@member.JoinedDate.ToString("yyyy-MM-dd")</td>
                        <td>@member.ExpirationDate?.ToString("yyyy-MM-dd")</td>
                        <td>@member.MembershipType</td>
                        <td>@member.Status</td>
                        <td>@member.CreatedBy</td>
                        <td>@member.ModifiedBy</td>
                        <td>
                            <a class="btn btn-primary btn-sm"
                               asp-controller="Member"
                               asp-action="EditMember"
                               asp-route-id="@member.MemberId">
                                Edit
                            </a>
                        </td>
                    </tr>

                    i++;
                }
            }
        </tbody>
    </table>
</div>