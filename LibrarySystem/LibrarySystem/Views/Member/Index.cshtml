@using LibrarySystem.Shared.MemberData
@model List<MemberDetails>
<h1>Hello Member Index</h1>
<a asp-controller="Member" asp-action="AddMember" class="btn btn-primary">Add Member</a>

@{
    string tempDataMessage = TempData["isSuccess"] as string;
    if (tempDataMessage == "YES")
    {
        <span class="text-success">@TempData["Message"]</span>
    }
    else
    {
        <span class="text-danger">@TempData["Message"]</span>
    }
}


<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>SN</th>
                <th>Member Id</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Email</th>
                <th>MembershipType</th>
                <th>Status</th>
                <th>Operations</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
                foreach (var member in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@member.MemberId</td>
                        <td>@member.MemberName</td>
                        <td>@member.PhoneNumber</td>
                        <td>@member.Address</td>
                        <td>@member.Email</td>
                        <td>@member.MembershipType</td>
                        <td>@member.Status</td>
                        <td><a class="btn btn-primary btn-sm" asp-controller="Member" asp-action="EditMember" asp-route-id="@member.MemberId">Edit</a></td>
                    </tr>
                    i++;
                }
            }
        </tbody>
    </table>
</div>